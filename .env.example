# Copia in .env e personalizza. .env è ignorato da git: MAI committare credenziali.

# --- Email: backend di invio ---------------------------------------------
# smtp   = server SMTP (es. Brevo: smtp-relay.brevo.com, porta 587, STARTTLS)
# resend = API Resend (RESEND_API_KEY)
# none   = disabilitato (le email vengono solo loggate)
EMAIL_BACKEND=none
EMAIL_FROM="School Feed Monitor <noreply@tuodominio.it>"
# EMAIL_REPLY_TO=tu@tuodominio.it

# SMTP (Brevo: "SMTP & API" > SMTP nel pannello; SMTP_USER è la login, SMTP_PASSWORD la chiave SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_TLS: starttls (default) | ssl | none
SMTP_TLS=starttls

# Resend (alternativa)
# RESEND_API_KEY=re_xxxxxxxx

# --- Web -------------------------------------------------------------------
# URL pubblico dell'app: usato nei link "gestisci preferenze" delle email
# APP_BASE_URL=https://checkfeed.tuodominio.it
